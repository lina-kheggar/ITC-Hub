# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database Connection (MongoDB or PostgreSQL)
MONGO_URI=mongodb://localhost:27017/itchub

# JWT Secrets & Expiration
JWT_SECRET=your_jwt_secret_change_me_in_production
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_SECRET=your_refresh_secret_change_me_in_production
REFRESH_TOKEN_EXPIRES_IN=7d

# Cache & Rate Limiting
REDIS_URL=redis://localhost:6379
CACHE_TTL_EVENTS_SECONDS=300
CACHE_TTL_AI_SECONDS=86400
CHAT_RATE_LIMIT_PER_MINUTE=20

# Optional LLM API Keys (Gemini, OpenAI, or Ollama)
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=
OLLAMA_URL=http://localhost:11434
